# Configuración de integraciones (docs/CONVENCIONES.md 4.3). Valores de ejemplo: nunca subir los reales.
REGION=region-1
PUERTO=3005
NIVEL_LOG=info
# Base propia del servicio (una base por servicio, ADR-001).
URL_BASE=postgres://integraciones:cambiar-clave@postgres:5432/integraciones
# RabbitMQ de la región (ADR-002).
URL_BROKER=amqp://trotamundos:cambiar-clave@rabbitmq:5672
# Clave pública del JWT de Autenticación de la región (ADR-014).
URL_JWKS=http://autenticacion:3001/.well-known/jwks.json
# Servicio de Usuarios de la región (perfil en POST /agencias/casos).
URL_USUARIOS=http://usuarios:3002

# Archivo YAML con el catálogo de proveedores, agencias y redes (opcional; por defecto config/proveedores.yaml).
# RUTA_CONFIG_PROVEEDORES=services/integraciones/config/proveedores.yaml

# Intervalo por defecto de consulta a proveedores que no avisan (en segundos; wiki: 120 s = 2 min).
INTERVALO_CONSULTA_PROVEEDORES_SEG=120
# Ventana inicial hacia atrás la primera vez que se consulta un proveedor sin cursor previo (segundos).
VENTANA_INICIAL_CONSULTA_SEG=300

# Proveedores de viaje (en Docker viven en la red global; ver infra/global.compose.yaml).
URL_AEROLINEA=http://mock-aerolinea:4003
CLAVE_API_AEROLINEA=cambiar-clave-api-aerolinea
SECRETO_WEBHOOK_AEROLINEA=cambiar-secreto-webhook-aerolinea

URL_HOTEL=http://mock-hotel:4004
CLAVE_API_HOTEL=cambiar-clave-api-hotel
# INTERVALO_CONSULTA_HOTEL_SEG=120

URL_RENTADORA=http://mock-rentadora:4005
CLAVE_API_RENTADORA=cambiar-clave-api-rentadora
# INTERVALO_CONSULTA_RENTADORA_SEG=120
URL_TRENES_DEL_SUR=http://mock-trenes:4008
CLAVE_API_TRENES_DEL_SUR=cambiar-clave-api-trenes
# INTERVALO_CONSULTA_TRENES_SEG=120

# Agencia de viajes y red social (usadas en P2.D3).
URL_AGENCIA=http://mock-agencia:4006
CLAVE_API_AGENCIA=cambiar-clave-api-agencia

URL_REDSOCIAL=http://mock-redsocial:4007
TOKEN_REDSOCIAL=cambiar-token-redsocial
