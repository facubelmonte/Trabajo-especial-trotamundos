{
  "name": "trotamundos",
  "version": "0.1.0",
  "private": true,
  "description": "Prototipo funcional del sistema Trotamundos (TPE Diseño de Sistemas de Software)",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "services/*",
    "mocks/*",
    "web"
  ],
  "scripts": {
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc -p tsconfig.json && tsc -p web/tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "test:contratos": "node infra/scripts/probar-contratos.ts",
    "e2e": "vitest run --passWithNoTests --config tests/e2e/vitest.config.ts",
    "e2e:web": "npm run e2e -w web",
    "nuevo-servicio": "node infra/scripts/nuevo-servicio.ts",
    "mock": "node infra/scripts/mock.ts",
    "infra:secretos": "node infra/scripts/secretos.ts",
    "infra:levantar": "node infra/scripts/infra.ts levantar",
    "infra:bajar": "node infra/scripts/infra.ts bajar",
    "infra:logs": "node infra/scripts/infra.ts logs",
    "infra:reset": "node infra/scripts/infra.ts reset",
    "infra:escalador": "node infra/scripts/escalador.ts",
    "infra:failover-viajes": "node infra/scripts/failover-viajes.ts",
    "semillas": "node scripts/semillas.ts",
    "caos": "vitest run --passWithNoTests --config tests/caos/vitest.config.ts",
    "carga:correos": "node tests/carga/primeros-correos.ts",
    "carga:proveedores": "node tests/carga/proveedores.ts",
    "carga:publicacion": "docker run --rm -i -e URL_API=http://host.docker.internal:8000 -e URL_MOCK_RED=http://host.docker.internal:4007 grafana/k6:1.0.0 run - < tests/carga/publicacion.k6.js",
    "carga:failover-viajes": "node tests/carga/failover-viajes.ts",
    "carga:caida-servicio": "node tests/carga/caida-servicio.ts",
    "carga:seguridad": "node tests/carga/seguridad.ts",
    "carga:idioma": "node tests/carga/idioma.ts",
    "carga:proveedor-sin-aviso": "node tests/carga/proveedor-sin-aviso.ts",
    "carga:panel": "docker run --rm -i -e URL_API=http://host.docker.internal:8000 grafana/k6:1.0.0 run - < tests/carga/panel.k6.js",
    "carga:primer-contenido": "npm run build -w web && node tests/carga/primer-contenido.ts",
    "carga:tormenta": "node tests/carga/tormenta.ts",
    "carga:mapreduce": "node tests/carga/mapreduce.ts",
    "carga:asistente": "node tests/carga/asistente.ts",
    "carga:publicacion:demora": "docker run --rm -i -e URL_API=http://host.docker.internal:8000 -e URL_MOCK_RED=http://host.docker.internal:4007 -e DEMORA_RED_MS=1000 grafana/k6:1.0.0 run - < tests/carga/publicacion.k6.js",
    "web": "npm run dev -w web",
    "web:api": "npm run api -w web"
  },
  "devDependencies": {
    "@asyncapi/parser": "^3.6.6",
    "@eslint/js": "^10.0.1",
    "@redocly/cli": "^2.79.0",
    "@stoplight/prism-cli": "^5.14.2",
    "@types/node": "^24.19.2",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "lighthouse": "13.6.0",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.0",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
}
