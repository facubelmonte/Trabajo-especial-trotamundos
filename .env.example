# Variables de la infraestructura (infra/region.compose.yaml e infra/global.compose.yaml).
# Valores de ejemplo: nunca subir los reales. Para desarrollo, npm run infra:secretos copia este
# archivo a .env y reemplaza cada valor "cambiar-..." por uno generado al azar.

# Nivel de log de todos los servicios (trace, debug, info, warn, error).
NIVEL_LOG=info
# Puerto de nginx de cada región hacia afuera (docs/CONVENCIONES.md 4.2).
PUERTO_NGINX_REGION_1=8081
PUERTO_NGINX_REGION_2=8082
# Enrutador global (Iteración 6): el único punto de entrada de la web. Las solicitudes sin JWT ni
# X-Region van a la región por defecto (en la wiki, la más cercana).
PUERTO_ENRUTADOR=8000
REGION_POR_DEFECTO=region-1
# Mock de Gmail (P2.B1): puerto, secreto del cliente OAuth y secreto de la URL de avisos push
# (?token=). El Servicio de Correo de cada región usa los mismos.
PUERTO_MOCK_GMAIL=4001
SECRETO_CLIENTE_GMAIL=cambiar-secreto-cliente-gmail
SECRETO_AVISOS_GMAIL=cambiar-secreto-avisos-gmail
# Mock de Outlook (P2.B2): puerto y secreto de la aplicación registrada. El Servicio de Correo de
# cada región usa los mismos.
PUERTO_MOCK_OUTLOOK=4002
SECRETO_CLIENTE_OUTLOOK=cambiar-secreto-cliente-outlook
# Mocks externos de Persona D (P2.D1): aerolínea (4003), hotel (4004), rentadora (4005), agencia
# (4006) y red social (4007). El Servicio de Integraciones de cada región usa las mismas claves.
PUERTO_MOCK_AEROLINEA=4003
CLAVE_API_AEROLINEA=cambiar-clave-api-aerolinea
SECRETO_WEBHOOK_AEROLINEA=cambiar-secreto-webhook-aerolinea
PUERTO_MOCK_HOTEL=4004
CLAVE_API_HOTEL=cambiar-clave-api-hotel
PUERTO_MOCK_RENTADORA=4005
CLAVE_API_RENTADORA=cambiar-clave-api-rentadora
CLAVE_API_TRENES_DEL_SUR=cambiar-clave-api-trenes
PUERTO_MOCK_AGENCIA=4006
CLAVE_API_AGENCIA=cambiar-clave-api-agencia
PUERTO_MOCK_REDSOCIAL=4007
TOKEN_REDSOCIAL=cambiar-token-redsocial

# Clave privada RS256 del JWT de cada región, PEM en base64 en una sola línea (ADR-014). Cada
# Autenticación firma con la suya y publica la pública en /.well-known/jwks.json.
JWT_CLAVE_PRIVADA_REGION_1=cambiar-clave-privada-pem-en-base64
JWT_CLAVE_PRIVADA_REGION_2=cambiar-clave-privada-pem-en-base64
# Clave AES-256 (32 bytes en base64) con la que Correo cifra los tokens OAuth de las casillas.
CLAVE_TOKENS_CORREO=cambiar-clave-aes-256-en-base64
# Secreto del Anonimizador para reemplazar el número de reserva por un código (Iteración 6).
SECRETO_ANALITICA=cambiar-secreto-analitica
# Origen de la aplicación web: el único al que el gateway le permite CORS.
ORIGEN_WEB=http://localhost:5173
# Grupo dueño del socket de Docker, para el monitor de salud: 0 en Docker Desktop; en Linux, el
# grupo docker (getent group docker | cut -d: -f3).
GID_DOCKER=0

# Contraseñas de PostgreSQL: el administrador de cada servidor, un usuario por servicio (ADR-001),
# el usuario de replicación de Viajes (ADR-012) y el usuario de la base de analítica global.
CLAVE_BD_ADMIN=cambiar-clave
CLAVE_BD_GATEWAY=cambiar-clave
CLAVE_BD_AUTENTICACION=cambiar-clave
CLAVE_BD_USUARIOS=cambiar-clave
CLAVE_BD_CORREO=cambiar-clave
CLAVE_BD_VIAJES=cambiar-clave
CLAVE_BD_INTEGRACIONES=cambiar-clave
CLAVE_BD_ANALITICA=cambiar-clave
CLAVE_BD_ASISTENTE=cambiar-clave
CLAVE_BD_REPLICACION=cambiar-clave
CLAVE_BD_ANALITICA_GLOBAL=cambiar-clave

# RabbitMQ: contraseña del usuario de los servicios y cookie de Erlang del cluster (perfil ha).
CLAVE_BROKER=cambiar-clave
COOKIE_BROKER=cambiar-cookie

# Secretos para pedir el token de servicio (POST /interna/tokens-servicio de Autenticación), uno
# por servicio. PRUEBAS solo existe en desarrollo y CI.
SECRETO_SERVICIO_AUTENTICACION=cambiar-secreto-autenticacion
SECRETO_SERVICIO_USUARIOS=cambiar-secreto-usuarios
SECRETO_SERVICIO_CORREO=cambiar-secreto-correo
SECRETO_SERVICIO_VIAJES=cambiar-secreto-viajes
SECRETO_SERVICIO_INTEGRACIONES=cambiar-secreto-integraciones
SECRETO_SERVICIO_ANALITICA=cambiar-secreto-analitica
SECRETO_SERVICIO_ASISTENTE=cambiar-secreto-asistente
SECRETO_SERVICIO_GATEWAY=cambiar-secreto-gateway
SECRETO_SERVICIO_PRUEBAS=cambiar-secreto-pruebas

# Contraseña del usuario analista de prueba (analista@trotamundos.example), que crean las semillas
# de Autenticación en cada región.
CONTRASENA_ANALISTA=cambiar-contrasena-analista

# Intervalos configurables para demo (docs/CONVENCIONES.md 4.3): por defecto 30 s en el Examinador
# de Correo y 120 s (2 min) en la consulta periódica a proveedores que no avisan (hotel, rentadora).
INTERVALO_EXAMINADOR_SEG=30
INTERVALO_CONSULTA_PROVEEDORES_SEG=120
